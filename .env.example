# Video SDK usage (required)
ZOOM_VSDK_KEY=
ZOOM_VSDK_SECRET=

# Zoom REST API usage (required)
ZOOM_API_KEY=
ZOOM_API_SECRET=

# URL pointing to your application e.g. https://localhost:3000 (required)
ENDPOINT_URL=

# Neon Postgres connection string (Neon dashboard > Connect), e.g. postgresql://user:pass@host/db?sslmode=require  (required)
DATABASE_URL=

# Port to run your application (optional)
PORT=